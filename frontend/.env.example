# Cùng origin; Vite proxy khi dev, reverse proxy khi production.
VITE_API_URL=/api

# GA4 chỉ chạy trên production tại courtsimvn.com/www.courtsimvn.com sau consent.
# Tắt Enhanced Measurement trong GA4 trước khi deploy. Đặt false để ngắt tracking.
VITE_GA_ENABLED=true

# Link trả lời Google Forms (https://forms.gle/... hoặc https://docs.google.com/forms/d/e/.../viewform).
# Để trống: nút khảo sát bị tắt; người dùng vẫn xem được kết quả. Đổi link cần build/deploy lại.
VITE_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeYO6CF-le_0AmzokC1iQNvLcjf8QxwNZM0f-ufeRNNosnQQw/viewform
