# Cùng origin; Vite proxy khi dev, reverse proxy khi production.
VITE_API_URL=/api

# GA4 chỉ chạy trên production tại courtsimvn.com/www.courtsimvn.com sau consent.
# Tắt Enhanced Measurement trong GA4 trước khi deploy. Đặt false để ngắt tracking.
VITE_GA_ENABLED=true

