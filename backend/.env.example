NODE_ENV=development
# Tạm bỏ qua OTP đăng ký/đăng nhập, chỉ có hiệu lực trong development.
AUTH_EMAIL_VERIFICATION_DISABLED=false
PORT=5000
HOST=127.0.0.1
# Khảo sát bắt buộc: xem docs/GOOGLE_FORMS_GATE.md. Thiếu cấu hình vẫn khóa kết quả.
# Đặt trên backend Render; link Google Forms đầy đủ kết thúc bằng /viewform.
VITE_FEEDBACK_FORM_URL=
SURVEY_TOKEN_ENTRY=
SURVEY_WEBHOOK_SECRET=
MONGO_URI=mongodb://127.0.0.1:27017/courtsim
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_ADMIN_EMAIL=admin@courtsim.local
SEED_ADMIN_PASSWORD=replace-with-admin-password
OPENAI_API_KEY=
# Có OPENAI_API_KEY: mặc định https://api.openai.com/v1. Endpoint tùy chỉnh phải dùng khóa riêng AI_API_KEY.
# AI_BASE_URL=
# AI_API_KEY=
AI_TIMEOUT_MS=60000
# Hạn mức cuộc gọi thực tới provider (bao gồm retry), kho Mongo dùng chung.
AI_USER_CALLS_PER_15_MIN=80
AI_USER_CALLS_PER_DAY=200
AI_GLOBAL_CALLS_PER_DAY=2000
# Bật đối chiếu trực tuyến; kho tài liệu nội bộ vẫn dùng được khi offline.
LEGAL_ONLINE_LOOKUP=true
# Bật web bổ sung cho mô phỏng/trợ lý, không giới hạn tên miền; chỉ tra luật Việt Nam.
# Chấm tham khảo từ nguyên văn web; trạng thái xác minh điều kiện áp dụng vẫn tách riêng.
LEGAL_WEB_REFERENCE_SCORING=true
# Quyết định/điều hành phiên tòa
AI_JUDGE_MODEL=gpt-5.6-terra

# Đối đáp liên tục → volume lớn
AI_OPPONENT_MODEL=gpt-5.6-luna

# Chỉ chạy khi kết thúc phiên
AI_EVALUATOR_MODEL=gpt-5.6-terra

# RAG cung cấp luật, model xử lý/giải thích
AI_ASSISTANT_MODEL=gpt-5.6-luna

# Speech → text
AI_VOICE_TO_TEXT=gpt-transcribe
# Authentication: email OTP qua Resend (xác minh domain gửi trước khi dùng).
EMAIL_API_KEY=
EMAIL_FROM=
# Google OAuth Web application. Không đưa client secret vào frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Chỉ đặt khi có reverse proxy tin cậy; ví dụ loopback hoặc subnet cụ thể.
TRUST_PROXY=
# AI usage: bật mặc định; dữ liệu cũ không được suy đoán token/chi phí.
AI_USAGE_TRACKING=true
# JSON theo khóa "provider:model", đơn giá USD / 1 triệu token và version do admin xác minh.
# Ví dụ cấu trúc (thay GIÁ và PHIÊN_BẢN bằng dữ liệu đã xác minh):
# {"openai-compatible:TÊN_MODEL":{"inputPerMillion":GIÁ,"cachedInputPerMillion":GIÁ,"outputPerMillion":GIÁ,"version":"PHIÊN_BẢN"}}
AI_MODEL_PRICING_JSON={}
# Chỉ backend/cron dùng khóa quản trị organization, không dùng khóa này để gọi model.
OPENAI_ADMIN_KEY=
# ID project CourtSim từ OpenAI, bắt đầu bằng proj_; bắt buộc để tránh lấy tổng organization.
OPENAI_PROJECT_ID=

# SePay Payment Gateway (server only). Start with credentials from SePay Sandbox.
PAYMENT_PROVIDER=sepay_gateway
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Backend polls the SePay API; no IPN secret or public callback endpoint is needed.
SEPAY_POLL_INTERVAL_MS=10000
# BANK_TRANSFER or NAPAS_BANK_TRANSFER; enable the selected method in SePay first.
SEPAY_PAYMENT_METHOD=BANK_TRANSFER
# One origin from CLIENT_ORIGIN. Callback URLs are generated by the backend.
PAYMENT_RETURN_ORIGIN=http://localhost:5173
# The backend needs outbound HTTPS access to pgapi-sandbox.sepay.vn / pgapi.sepay.vn.
# See docs/SEPAY_PAYMENTS.md for polling and local development.

# Legacy direct QR transfer only: set PAYMENT_PROVIDER=sepay_bank_transfer.
# Required in every environment: unsigned webhooks never grant access.
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_NAME=
