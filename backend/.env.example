NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/courtsim
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_ADMIN_EMAIL=admin@courtsim.local
SEED_ADMIN_PASSWORD=replace-with-admin-password
GEMINI_API_KEY=
# Khi không dùng Gemini, có thể cấu hình một API OpenAI-compatible khác:
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_JUDGE_MODEL=gemini-3.6-flash
AI_OPPONENT_MODEL=gemini-3.6-flash
AI_EVALUATOR_MODEL=gemini-3.6-flash
